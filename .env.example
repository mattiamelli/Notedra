# Optional cloud-sync configuration for local development.
# Copy this file to .env.local and fill in the values locally.
# Never commit .env, .env.local, or production credentials.
# VITE_* values are included in the browser bundle; use only public client configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
