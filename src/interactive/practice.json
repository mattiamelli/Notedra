        "right": {
          "kind": "variable",
          "name": "Q"
        }
      }
    },
    "reference": {
      "kind": "choice",
      "value": [
        "connective=or"
      ]
    },
    "explanation": "Necessity rules out P true with Q false. ¬P ∨ Q has exactly that false row. It does not assert Q is sufficient for P.",
    "mode": "practice"
